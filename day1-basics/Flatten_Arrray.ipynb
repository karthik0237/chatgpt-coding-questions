    "# Python: Flatten a nested list\n",
    "data = [[1,2], [3,4], [5], [6,7]]\n",
    "\n",
    "flattened_list = []\n",
    "\n",
    "for sublist in data:\n",
    "    for ele in sublist:\n",
    "        flattened_list.append(ele)\n",
    "print(flattened_list)\n"
